rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Çift Sayfaları (/couples/{slug})
    // Çift sayfaları (QR kod, link paylaşımı, web ziyaretçileri) herkese açık okunabilir olmalıdır.
    match /couples/{slug} {
      // Sayfayı herkes görüntüleyebilir (Ziyaretçiler, partnerler, misafirler)
      allow read: if true;

      // Sayfa oluşturma ve güncelleme (Kayıt, checkout, dashboard ve oyun/anılar için)
      allow create, update: if true;
      allow delete: if request.auth != null;

      // Çift sayfasına ait tüm alt modüller ve koleksiyonlar (anılar, oyunlar, harita, kanvas, çizimler vb.)
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // 2. Kullanıcı Hesapları (/users/{userId})
    // Her kullanıcı sadece kendi hesap verisini okuyabilir ve güncelleyebilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Varsayılan Güvenlik Kuralı: Diğer tüm koleksiyonlar için auth zorunlu
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

