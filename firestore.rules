rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Couples Collection: Allow public read access to active couple pages
    match /couples/{slug} {
      allow read: if true;
      allow create, update, delete: if true; // Public or authenticated user management

      // Sub-collections: memories, map_markers, bucket_list, spotify, love_jar
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

  }
}
