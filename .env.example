# Firebase Client Configuration (asksite-saas)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=asksite-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=asksite-saas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=asksite-saas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional Firebase Admin SDK Configuration
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key_here"

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Shopier Live API Integration
SHOPIER_API_TOKEN=your_shopier_jwt_bearer_token
NEXT_PUBLIC_APP_URL=https://www.asksite.com.tr
